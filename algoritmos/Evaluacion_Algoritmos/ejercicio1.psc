//Hacer un algoritmo que genere los valores de y para valores de x desde 1 hasta 10. Utilizar un ciclo mientras en la solución.
	//			y = 3x^2 - 2x + 5
Algoritmo ejercicio1
	Definir x,c Como Entero
	x<-1
	Mientras x<11 Hacer
		c<-3*(x^2)-(2*x)+5
		Escribir "El valor de C cuando x equivale a ",x," es: " c
		x<-x+1
	Fin Mientras
	
FinAlgoritmo
