//Hacer un algoritmo que lea una cadena de texto e informe la cantidad de vocales existentes.
Algoritmo vocal_de_un_texto
    Definir texto, vocales Como Cadena
    Definir i Como Entero
    Definir c Como Caracter
	
    //vocales <- ""
	
    Escribir "Ingrese una palabra o frase:"
    Leer texto
	
    Para i <- 1 Hasta Longitud(texto) Hacer
        
        c <- Subcadena(texto, i, 1)
        c <- Minusculas(c)
		
        // Verificar si es letra
        Si (c >= "A" Y c <= "Z") Entonces
			
            // Verificar si es vocal
            Si c = "a" O c = "e" O c = "i" O c = "o" O c = "u" Entonces
                vocales <- vocales + c
            
            FinSi
			
        FinSi
		
    FinPara
	
    Escribir "Vocales encontradas: ", vocales
    
	
FinAlgoritmo
